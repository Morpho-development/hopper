APP_DOMAIN=localhost
APP_ENV=development
HTTP_ADDR=:8080
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

DATABASE_PATH=/data/hopper.db
STORAGE_PATH=/storage

# Required: generate with `openssl rand -hex 48`.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

REGISTRATION_ENABLED=false
FIRST_RUN_ADMIN_LOGIN=admin
# Required for an empty production instance. Development may leave it empty for one-time log generation.
FIRST_RUN_ADMIN_PASSWORD=
MAX_UPLOAD_BYTES=104857600
INSTANCE_QUOTA_BYTES=10737418240
AUTH_RATE_LIMIT_PER_MINUTE=10
